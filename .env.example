# Public application configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sanity — browser-safe identifiers
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-03-01"

# Sanity Studio build configuration
SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"

# Sanity server credentials — never expose with NEXT_PUBLIC_
SANITY_API_READ_TOKEN="replace-with-private-dataset-viewer-token"
SANITY_API_WRITE_TOKEN="replace-with-least-privilege-write-token"

# Gemini
# Used for PDF extraction, cited chat, and persisted AI handbook drafting.
GOOGLE_GENERATIVE_AI_API_KEY="replace-with-google-ai-studio-key"
# Deployment-selected stable model; update deliberately when model lifecycle changes.
GEMINI_MODEL="gemini-3.8-flash"

# Firecrawl external research
# Chat fallback; discovered PDFs can be imported only after explicit confirmation.
FIRECRAWL_API_KEY="fc-replace-with-api-key"
# Preferred official sources, comma-separated. Customize for the industries you support.
REGULATORY_OFFICIAL_DOMAINS="fda.gov,osha.gov,usda.gov"

# Private Vercel Blob temporary upload store
# Use a PRIVATE store. Browser uploads must request access: private.
BLOB_READ_WRITE_TOKEN="vercel_blob_replace-with-token"

# Upstash Redis rate limiting
# Also required in production for handbook generation and chat-import locks.
UPSTASH_REDIS_REST_URL="https://replace-with-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# Public MCP endpoint authentication
MCP_TOOL_SECRET="replace-with-a-long-random-secret"

# Authentication & Database (Prisma + Better-Auth)
DATABASE_URL="postgresql://user:password@localhost:5432/compliance_app?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-random-secret"
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"
